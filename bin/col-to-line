#!/usr/bin/env python

import sys

if len(sys.argv) != 3:
    print("Usage: python col-to-line.py <filename> <col>")
    exit(1)

filename = sys.argv[1]
col = int(sys.argv[2])

with open(filename, 'r') as f:
    cur_line = 0
    cur_col = 0
    for line in f:
        cur_line += 1
        cur_col += len(line)
        if cur_col >= col:
            print(cur_line)
            exit()

print("Error: column out of range")
print("Last line: " + str(cur_line))
print("Last column: " + str(cur_col))
exit(1)
