#!/bin/bash
# generate a random password

function usage {
        echo "Usage: $(basename $0) [-dsu] [-l LENGTH]" 2>&1
        echo 'Generate a random password.'
        echo '   -l LENGTH   Specify the password length'
        echo '   -s          Include the special characters +=/'
        echo '   -d          Include digits'
        echo '   -D          Only use digits'
        echo '   -u          Include uppercase letters'
        echo '   -U          Only use uppercase letters'
        echo '   -h          Show this help'
}

# Set default token length
LENGTH=32

# Define list of arguments expected in the input
optstring=":shuUdDl:"

while getopts ${optstring} arg; do
  case ${arg} in
    l)
        LENGTH="${OPTARG}"
        ;;
    d)
        USE_DIGITS='true'
        ;;
    D)
        ONLY_DIGITS='true'
        ;;
    s)
        USE_SPECIAL_CHAR='true'
        ;;
    u)
        USE_UPPER_CASE='true'
        ;;
    U)
        ONLY_UPPER_CASE='true'
        ;;
    h)
        usage
        exit 0
        ;;
    ?)
        echo "Invalid option: -${OPTARG}."
        echo
        usage
        exit 1
        ;;
  esac
done

FILTER='a-z'

if [[ -n "$ONLY_UPPER_CASE" ]]; then
    FILTER='A-Z'
fi

if [[ -n "$ONLY_DIGITS" ]]; then
    FILTER='0-9'
fi

if [[ -n "$USE_UPPER_CASE" ]]; then
    FILTER="${FILTER}A-Z"
fi

if [[ -n "$USE_DIGITS" ]]; then
    FILTER="${FILTER}0-9"
fi

if [[ -n "$USE_SPECIAL_CHAR" ]]; then
    FILTER="$FILTER+=/"
fi


cat /dev/urandom | LC_ALL=C tr -dc "$FILTER" | fold -w "$LENGTH" | head -n 1
